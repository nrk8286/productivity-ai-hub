{
  "buildCommand": "prisma generate && next build",
  "devCommand": "next dev",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "regions": [
    "iad1"
  ],
  "env": {
    "NEXT_PUBLIC_APP_NAME": "Productivity AI Hub",
    "NODE_ENV": "production"
  },
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ]
}
